<?xml version="1.0"?>
<!--
  The sample AMR as a firefighting robot (RFC 0022 §8, docs/guide/tutorial-fire.md): the sample
  differential-drive AMR with a 40 L water tank behind its mast and a water monitor in front, a
  nozzle on a pan and a tilt joint. The nozzle and pump values are illustrative, of the size a
  small electric firefighting robot carries, not a model of any real product: an 8 mm smooth
  bore, discharge coefficient 0.95 (TODO(verify) a smooth-bore nozzle's datasheet), 0.5 bar from
  the pump, which gives 9.5 m/s and 0.48 kg/s (29 L/min) and about 9 m of reach on level ground.
  The tank's water is a weight at the tank that shrinks as it empties; the links' masses are dry.

  The base_link frame is at axle height, in the middle of the chassis. The simulator lifts the
  robot so that its lowest collision shape touches the ground. Aim it with joint commands on
  pan_joint and tilt_joint (tilt up is positive), open the valve on /nozzle/command (0 to 1).
-->
<robot name="amr_firefighter">
  <material name="body">
    <color rgba="0.20 0.24 0.30 1"/>
  </material>
  <material name="accent">
    <color rgba="0.91 0.47 0.18 1"/>
  </material>
  <material name="rubber">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>
  <material name="red">
    <color rgba="0.78 0.10 0.10 1"/>
  </material>
  <material name="steel">
    <color rgba="0.62 0.64 0.67 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="20.0"/>
      <!-- box 0.60 x 0.40 x 0.15 m -->
      <inertia ixx="0.30417" iyy="0.6375" izz="0.86667" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry>
        <box size="0.60 0.40 0.15"/>
      </geometry>
      <material name="body"/>
    </visual>
    <visual>
      <origin xyz="0.28 0 0.07"/>
      <geometry>
        <box size="0.04 0.30 0.04"/>
      </geometry>
      <material name="accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry>
        <box size="0.60 0.40 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Driven wheels: radius 0.10 m, width 0.05 m, 1.5 kg. -->
  <link name="left_wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0040625" iyy="0.0075" izz="0.0040625" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.23 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0040625" iyy="0.0075" izz="0.0040625" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.23 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <!-- Swivel casters, front and back: a fork turning about z, a 0.03 m ball under it. -->
  <link name="front_caster_fork">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="-0.015 0 -0.01"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>
  <joint name="front_caster_swivel" type="continuous">
    <parent link="base_link"/>
    <child link="front_caster_fork"/>
    <origin xyz="0.22 0 -0.04"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="front_caster_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000072" iyy="0.000072" izz="0.000072" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_caster_axle" type="continuous">
    <parent link="front_caster_fork"/>
    <child link="front_caster_wheel"/>
    <origin xyz="-0.03 0 -0.03"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_caster_fork">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="-0.015 0 -0.01"/>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>
  <joint name="rear_caster_swivel" type="continuous">
    <parent link="base_link"/>
    <child link="rear_caster_fork"/>
    <origin xyz="-0.22 0 -0.04"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rear_caster_wheel">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000072" iyy="0.000072" izz="0.000072" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_caster_axle" type="continuous">
    <parent link="rear_caster_fork"/>
    <child link="rear_caster_wheel"/>
    <origin xyz="-0.03 0 -0.03"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- A 2D lidar on a short mast at the front, above the chassis. -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="lidar_mount" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.13"/>
  </joint>

  <!-- Roof lidar on a mast: visual only, so that its own beams never hit it. -->
  <link name="lidar_mast">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0007" iyy="0.0007" izz="0.00002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.20"/>
      </geometry>
      <material name="body"/>
    </visual>
  </link>
  <joint name="mast_mount" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mast"/>
    <origin xyz="-0.10 0 0.205"/>
  </joint>
  <link name="top_lidar_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
      <material name="accent"/>
    </visual>
  </link>
  <joint name="top_lidar_mount" type="fixed">
    <parent link="lidar_mast"/>
    <child link="top_lidar_link"/>
    <origin xyz="0 0 0.135"/>
  </joint>

  <!-- The water tank: 40 L behind the mast. Its link is the empty tank (2 kg). -->
  <link name="tank_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0236" iyy="0.0097" izz="0.0247" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.18 0.34 0.16"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.18 0.34 0.16"/>
      </geometry>
    </collision>
  </link>
  <joint name="tank_mount" type="fixed">
    <parent link="base_link"/>
    <child link="tank_link"/>
    <origin xyz="-0.20 0 0.185"/>
  </joint>
  <!-- The monitor: a turret that pans about z and a barrel that tilts up. -->
  <link name="pan_link">
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.5"/>
      <inertia ixx="0.0007" iyy="0.0007" izz="0.0004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <cylinder radius="0.04" length="0.12"/>
      </geometry>
      <material name="steel"/>
    </visual>
  </link>
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0.05 0 0.105"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="5.0" velocity="1.5"/>
    <dynamics damping="0.2"/>
  </joint>
  <link name="tilt_link">
    <inertial>
      <origin xyz="0.06 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0001" iyy="0.0004" izz="0.0004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.12"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <!-- Tilting up is a positive angle: the axis is -y. -->
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.15"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.5" upper="1.2" effort="5.0" velocity="1.5"/>
    <dynamics damping="0.2"/>
  </joint>
  <gazebo reference="tank_link">
    <water_tank name="tank" capacity="0.04" initial="1"/>
  </gazebo>
  <gazebo reference="tilt_link">
    <nozzle name="nozzle" xyz="0.12 0 0" axis="1 0 0" diameter="0.008"
            discharge_coefficient="0.95" pressure="50000" agent="water"
            spray_half_angle="0.03" pump_efficiency="0.5" tank="tank"/>
  </gazebo>
  <!-- Sensors, in the Gazebo form most robot descriptions use. -->
  <gazebo reference="lidar_link">
    <sensor name="front_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- A 16-ring 3D lidar: 360 degrees in 900 columns, rings from -15 to +15 degrees. -->
  <gazebo reference="top_lidar_link">
    <sensor name="top_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>900</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>40.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <stddev>0.02</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <z><noise type="gaussian"><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><stddev>0.02</stddev></noise></x>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Which joints take commands: the driven wheels, by speed (diff_drive_controller) or torque. -->
  <ros2_control name="LagrangeSystem" type="system">
    <hardware>
      <plugin>lagrange_ros2_control/LagrangeSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <!-- Wheel speed servo (N·m per rad/s, N·m per rad) for velocity commands. -->
      <param name="velocity_p">8.0</param>
      <param name="velocity_i">40.0</param>
      <!-- Wheel encoder: counts per revolution after quadrature (a 4096-line encoder). -->
      <param name="encoder_resolution">16384</param>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <!-- Wheel speed servo (N·m per rad/s, N·m per rad) for velocity commands. -->
      <param name="velocity_p">8.0</param>
      <param name="velocity_i">40.0</param>
      <!-- Wheel encoder: counts per revolution after quadrature (a 4096-line encoder). -->
      <param name="encoder_resolution">16384</param>
    </joint>
  </ros2_control>
</robot>
