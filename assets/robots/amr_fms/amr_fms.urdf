      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.0523" iyz="0" izz="0.0523" />
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0.00000 0.00000 0.05000" rpy="0.00000 0.00000 0.00000" />
  </joint>
  <joint name="rocker_joint" type="revolute">
    <parent link="base_link" />
    <child link="rocker_link" />
    <origin xyz="0.26500 0.00000 0.10000" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="1 0 0" />
    <limit lower="-0.02618" upper="0.02618" effort="100" velocity="1" />
    <dynamics damping="5.0" friction="0.0" />
  </joint>
  <joint name="swerve_fl_steer_joint" type="continuous">
    <parent link="rocker_link" />
    <child link="swerve_fl_steer_link" />
    <origin xyz="0.00000 0.15500 0.00700" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 0 1" />
    <limit effort="20.0" velocity="6.0" />
    <dynamics damping="0.2" friction="0.0" />
  </joint>
  <joint name="swerve_fr_steer_joint" type="continuous">
    <parent link="rocker_link" />
    <child link="swerve_fr_steer_link" />
    <origin xyz="0.00000 -0.15500 0.00700" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 0 1" />
    <limit effort="20.0" velocity="6.0" />
    <dynamics damping="0.2" friction="0.0" />
  </joint>
  <joint name="swerve_rl_steer_joint" type="continuous">
    <parent link="base_link" />
    <child link="swerve_rl_steer_link" />
    <origin xyz="-0.26500 0.15500 0.10700" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 0 1" />
    <limit effort="20.0" velocity="6.0" />
    <dynamics damping="0.2" friction="0.0" />
  </joint>
  <joint name="swerve_rr_steer_joint" type="continuous">
    <parent link="base_link" />
    <child link="swerve_rr_steer_link" />
    <origin xyz="-0.26500 -0.15500 0.10700" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 0 1" />
    <limit effort="20.0" velocity="6.0" />
    <dynamics damping="0.2" friction="0.0" />
  </joint>
  <joint name="swerve_fl_wheel_joint" type="continuous">
    <parent link="swerve_fl_steer_link" />
    <child link="swerve_fl_wheel_link" />
    <origin xyz="0.00000 0.00000 -0.09450" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 1 0" />
    <limit effort="8.0" velocity="24.0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <joint name="swerve_fr_wheel_joint" type="continuous">
    <parent link="swerve_fr_steer_link" />
    <child link="swerve_fr_wheel_link" />
    <origin xyz="0.00000 0.00000 -0.09450" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 1 0" />
    <limit effort="8.0" velocity="24.0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <joint name="swerve_rl_wheel_joint" type="continuous">
    <parent link="swerve_rl_steer_link" />
    <child link="swerve_rl_wheel_link" />
    <origin xyz="0.00000 0.00000 -0.09450" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 1 0" />
    <limit effort="8.0" velocity="24.0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <joint name="swerve_rr_wheel_joint" type="continuous">
    <parent link="swerve_rr_steer_link" />
    <child link="swerve_rr_wheel_link" />
    <origin xyz="0.00000 0.00000 -0.09450" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 1 0" />
    <limit effort="8.0" velocity="24.0" />
    <dynamics damping="0.01" friction="0.0" />
  </joint>
  <joint name="laser_front_right_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_front_right" />
    <origin xyz="0.39500 -0.24000 0.14000" rpy="0.00000 0.00000 -0.78540" />
  </joint>
  <joint name="laser_rear_left_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_rear_left" />
    <origin xyz="-0.39500 0.24000 0.14000" rpy="0.00000 0.00000 2.35619" />
  </joint>
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link" />
    <child link="lift_top_platform" />
    <origin xyz="0.00000 0.00000 0.30094" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.1500" effort="3000" velocity="0.05" />
    <dynamics damping="50.0" friction="0.0" />
  </joint>
  <joint name="scissor_inner_joint" type="revolute">
    <parent link="base_link" />
    <child link="scissor_inner_link" />
    <origin xyz="-0.18836 0.00000 0.16500" rpy="0 -0.26180 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0.0" upper="0.43718" effort="300" velocity="1.0" />
    <dynamics damping="1.0" friction="0.0" />
  </joint>
  <joint name="lift_carriage_joint" type="prismatic">
    <parent link="base_link" />
    <child link="lift_carriage_link" />
    <origin xyz="0.18835 0.00000 0.16500" rpy="0.00000 0.00000 0.00000" />
    <axis xyz="1 0 0" />
    <limit lower="-0.07816" upper="0.0" effort="500" velocity="0.2" />
    <dynamics damping="1.0" friction="0.0" />
  </joint>
  <joint name="scissor_outer_joint" type="revolute">
    <parent link="lift_carriage_link" />
    <child link="scissor_outer_link" />
    <origin xyz="0.00000 0.00000 0.00000" rpy="0 0.26180 0" />
    <axis xyz="0 1 0" />
    <limit lower="0.0" upper="0.43718" effort="300" velocity="1.0" />
    <dynamics damping="1.0" friction="0.0" />
  </joint>
  <gazebo reference="laser_front_right">
    <sensor name="scan_front_right" type="gpu_lidar">
      <topic>scan_front_right</topic>
      <frame_id>laser_front_right</frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1228</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="laser_rear_left">
    <sensor name="scan_rear_left" type="gpu_lidar">
      <topic>scan_rear_left</topic>
      <frame_id>laser_rear_left</frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1228</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <frame_id>base_link</frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>
  <!-- Which joints take commands: the swerve controller steers and drives the four modules. -->
  <ros2_control name="LagrangeSystem" type="system">
    <hardware><plugin>lagrange_ros2_control/LagrangeSystem</plugin></hardware>
    <joint name="swerve_fl_steer_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_fr_steer_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_rl_steer_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_rr_steer_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_fl_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_fr_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_rl_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="swerve_rr_wheel_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
