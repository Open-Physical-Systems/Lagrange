<?xml version="1.0"?>
<!--
  The swerve AMR of the AMR_FMS project (same author as this sample, Apache-2.0): a 4-wheel
  swerve base with a passive front rocker, a scissor lift and two 2D lidars (LDROBOT M10P
  class). From AMR_FMS's amr_description/urdf/amr_sim.urdf (made there by
  scripts/gen_sim_urdf.py from the CAD export), with its meshes in meshes/. Changes for
  Lagrange: mesh paths relative to this file, the Gazebo system plugins removed (the built-in
  swerve controller drives the base), and a ros2_control block that names the steer and wheel
  joints as driven. The lift stays collapsed: its joints are not driven yet.
-->
<robot name="amr">
  <link name="base_footprint">
  </link>
  <link name="base_link">
    <visual>
      <origin xyz="0.00000 0.00000 0.00000" rpy="0.00000 0.00000 0.00000" />
      <geometry>
        <mesh filename="meshes/chassis_frame.dae" />
      </geometry>
    </visual>
