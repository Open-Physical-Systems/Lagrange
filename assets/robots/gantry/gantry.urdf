<?xml version="1.0"?>
<!-- A two-axis gantry on steppers (RFC 0020 §4.5), the sample of docs/physics/actuators.md
     "Steppers": x on a GT2 belt, y on a T8 lead screw, as on a desktop printer or a pick-and-place
     head. Its motors, drivers and supply are in gantry.overlay.yaml. Dimensions and masses are
     illustrative, not a real product. -->
<robot name="gantry">
  <link name="world"/>
  <link name="frame">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="8"/>
      <inertia ixx="0.18" iyy="0.18" izz="0.36" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.6 0.5 0.04"/></geometry>
      <material name="grey"><color rgba="0.35 0.37 0.4 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.22 0.06"/>
      <geometry><box size="0.6 0.03 0.04"/></geometry>
      <material name="aluminium"><color rgba="0.78 0.79 0.81 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.22 0.06"/>
      <geometry><box size="0.6 0.03 0.04"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.6 0.5 0.04"/></geometry>
    </collision>
  </link>
  <joint name="frame_fixed" type="fixed">
    <parent link="world"/>
    <child link="frame"/>
  </joint>

  <!-- X: the beam across the rails, on a 20-tooth GT2 belt (40 mm a turn). -->
  <link name="beam">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.02" iyy="0.0003" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.47 0.03"/></geometry>
      <material name="aluminium"/>
    </visual>
    <visual>
      <origin xyz="0.0 0 0.017"/>
      <geometry><cylinder radius="0.004" length="0.44"/></geometry>
      <material name="steel"><color rgba="0.6 0.6 0.62 1"/></material>
    </visual>
  </link>
  <joint name="x" type="prismatic">
    <parent link="frame"/>
    <child link="beam"/>
    <origin xyz="0 0 0.1"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.25" upper="0.25" effort="100" velocity="0.2"/>
    <dynamics damping="5"/>
  </joint>

  <!-- Y: the head on the beam, on a T8 lead screw (8 mm lead). -->
  <link name="head">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
      <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 -0.01"/>
      <geometry><cylinder radius="0.006" length="0.05"/></geometry>
      <material name="steel"/>
    </visual>
  </link>
  <joint name="y" type="prismatic">
    <parent link="beam"/>
    <child link="head"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.2" upper="0.2" effort="300" velocity="0.04"/>
    <dynamics damping="5"/>
  </joint>
</robot>
