<?xml version="1.0"?>
<!-- A pan-tilt head on two hobby servos (RFC 0020 §4.3), the sample of docs/physics/actuators.md
     "Servos": pan about z, tilt about y carrying a small camera block 3 cm ahead of its axis.
     The servos, their motors and the 2S battery are in pan_tilt.overlay.yaml. Dimensions are
     illustrative, not a real product. -->
<robot name="pan_tilt">
  <link name="world"/>
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.5"/>
      <inertia ixx="0.0004" iyy="0.0004" izz="0.0006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.1 0.1 0.04"/></geometry>
      <material name="grey"><color rgba="0.35 0.37 0.4 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.055"/>
      <geometry><box size="0.04 0.02 0.03"/></geometry>
      <material name="black"><color rgba="0.08 0.08 0.09 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.1 0.1 0.04"/></geometry>
    </collision>
  </link>
  <joint name="base_fixed" type="fixed">
    <parent link="world"/>
    <child link="base"/>
  </joint>

  <!-- Pan: a bracket turning about z. -->
  <link name="pan_bracket">
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="0.05"/>
      <inertia ixx="2.0e-5" iyy="2.0e-5" izz="1.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.005"/>
      <geometry><box size="0.05 0.05 0.01"/></geometry>
      <material name="orange"><color rgba="0.95 0.55 0.15 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.027 0.03"/>
      <geometry><box size="0.03 0.004 0.05"/></geometry>
      <material name="orange"/>
    </visual>
    <visual>
      <origin xyz="0 -0.027 0.03"/>
      <geometry><box size="0.03 0.004 0.05"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="pan" type="revolute">
    <parent link="base"/>
    <child link="pan_bracket"/>
    <origin xyz="0 0 0.07"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="10"/>
  </joint>

  <!-- Tilt: the camera block, its centre 3 cm ahead of the axis, so the tilt servo holds it. -->
  <link name="camera_block">
    <inertial>
      <origin xyz="0.03 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="2.0e-5" iyy="3.0e-5" izz="3.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.06 0.04 0.03"/></geometry>
      <material name="blue"><color rgba="0.2 0.45 0.85 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.055 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.01" length="0.012"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="tilt" type="revolute">
    <parent link="pan_bracket"/>
    <child link="camera_block"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="1.0" velocity="10"/>
  </joint>
</robot>
