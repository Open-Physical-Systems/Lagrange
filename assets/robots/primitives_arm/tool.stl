solid tool
  facet normal 0 0 -1
    outer loop
      vertex 0 -30 -30
      vertex 0 30 -30
      vertex 0 0 30
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 0 -30 -30
      vertex 60 0 0
      vertex 0 30 -30
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 0 30 -30
      vertex 60 0 0
      vertex 0 0 30
    endloop
  endfacet
  facet normal 0 0 0
    outer loop
      vertex 0 0 30
      vertex 60 0 0
      vertex 0 -30 -30
    endloop
  endfacet
endsolid tool
