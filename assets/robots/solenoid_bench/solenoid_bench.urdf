<?xml version="1.0"?>
<!-- A push-pull solenoid on a bench (RFC 0020 §4.6), the sample of docs/physics/actuators.md
     "Solenoids": a frame fixed to the ground and a 20 g plunger sliding 10 mm along x into its
     coil. The coil and spring are in solenoid_bench.overlay.yaml. Dimensions are illustrative,
     not a real product. -->
<robot name="solenoid_bench">
  <link name="world"/>
  <link name="frame">
    <inertial>
      <origin xyz="0 0 0.015"/>
      <mass value="0.2"/>
      <inertia ixx="2.0e-5" iyy="4.0e-5" izz="4.0e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0 0.015"/>
      <geometry><box size="0.03 0.025 0.025"/></geometry>
      <material name="steel"><color rgba="0.55 0.57 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.015"/>
      <geometry><box size="0.03 0.025 0.025"/></geometry>
    </collision>
  </link>
  <joint name="frame_fixed" type="fixed">
    <parent link="world"/>
    <child link="frame"/>
  </joint>

  <!-- The plunger: a rod that slides into the coil along +x; its limits are the stops. -->
  <link name="plunger_rod">
    <inertial>
      <origin xyz="-0.02 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1.0e-7" iyy="3.0e-6" izz="3.0e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="-0.02 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.004" length="0.04"/></geometry>
      <material name="brass"><color rgba="0.8 0.65 0.3 1"/></material>
    </visual>
  </link>
  <joint name="plunger" type="prismatic">
    <parent link="frame"/>
    <child link="plunger_rod"/>
    <origin xyz="-0.005 0 0.015"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.010" effort="50" velocity="5"/>
  </joint>
</robot>
