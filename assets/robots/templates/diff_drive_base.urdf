<?xml version="1.0"?>
<!-- Template of the robot builder (RFC 0016): a differential-drive base, two driven wheels
     and a caster. Sizes, densities, efforts and speeds are illustrative; edit them. -->
<robot name="diff_drive_base">
  <material name="builder_color_1">
    <color rgba="0.66 0.72 0.81 1"/>
  </material>
  <material name="builder_color_2">
    <color rgba="0.16 0.18 0.22 1"/>
  </material>
  <link name="base_link" lagrange_density="1240">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0"/>
      <mass value="14.879999999999999"/>
      <inertia ixx="0.124" ixy="0" ixz="0" iyy="0.21080000000000002" iyz="0" izz="0.31"/>
    </inertial>
    <visual>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
      <material name="builder_color_1"/>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.1"/></geometry>
    </collision>
  </link>
  <link name="left_wheel" lagrange_density="1100">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0"/>
      <mass value="0.6773273761139597"/>
      <inertia ixx="0.0009200363525547953" ixy="0" ixz="0" iyy="0.0016594520714792015" iyz="-1.6418327118392777e-19" izz="0.0009200363525547953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
      <material name="builder_color_2"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
    </collision>
  </link>
  <link name="right_wheel" lagrange_density="1100">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0"/>
      <mass value="0.6773273761139597"/>
      <inertia ixx="0.0009200363525547953" ixy="0" ixz="0" iyy="0.0016594520714792015" iyz="-1.6418327118392777e-19" izz="0.0009200363525547953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
      <material name="builder_color_2"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
    </collision>
  </link>
  <link name="caster" lagrange_density="1100">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0"/>
      <mass value="0.19755381803323824"/>
      <inertia ixx="9.680137083628676e-05" ixy="0" ixz="0" iyy="9.680137083628676e-05" iyz="0" izz="9.680137083628676e-05"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="builder_color_2"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.08 0.17 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="10"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.08 -0.17 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5" velocity="10"/>
  </joint>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.15 0 -0.065" rpy="0 0 0"/>
  </joint>
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>100</update_rate>
    </sensor>
  </gazebo>
</robot>
