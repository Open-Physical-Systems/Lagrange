<?xml version="1.0"?>
<!-- Template of the robot builder (RFC 0016): a pan-tilt head with a camera on a fixed base (the
     root link "world" bolts it to the ground). Sizes, densities, limits, efforts and speeds
     are illustrative; edit them. -->
<robot name="pan_tilt">
  <material name="builder_color_1">
    <color rgba="0.66 0.72 0.81 1"/>
  </material>
  <material name="builder_color_2">
    <color rgba="0.16 0.18 0.22 1"/>
  </material>
  <link name="world">
  </link>
  <link name="base_link" lagrange_density="2700">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0.02"/>
      <mass value="1.08"/>
      <inertia ixx="0.0010440000000000004" ixy="0" ixz="0" iyy="0.0010440000000000004" iyz="0" izz="0.0018000000000000004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.04"/></geometry>
      <material name="builder_color_1"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.04"/></geometry>
    </collision>
  </link>
  <link name="pan_link" lagrange_density="1240">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0.02"/>
      <mass value="0.17856"/>
      <inertia ixx="7.7376e-05" ixy="0" ixz="0" iyy="7.7376e-05" iyz="0" izz="0.00010713599999999999"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
      <material name="builder_color_1"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
    </collision>
  </link>
  <link name="tilt_link" lagrange_density="1240">
    <inertial lagrange_overrides="">
      <origin xyz="0 0 0"/>
      <mass value="0.15872000000000003"/>
      <inertia ixx="0.00010581333333333335" ixy="0" ixz="0" iyy="4.232533333333334e-05" iyz="0" izz="0.00010581333333333335"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="builder_color_2"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="2" velocity="3"/>
  </joint>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="1" effort="2" velocity="3"/>
  </joint>
  <gazebo reference="tilt_link">
    <sensor name="camera" type="camera">
      <pose>0.02 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <height>480</height>
          <width>640</width>
        </image>
      </camera>
    </sensor>
  </gazebo>
</robot>
