<?xml version="1.0" encoding="UTF-8"?>
<!--
  A cut-in on the city block (assets/worlds/city_block/city_block.xodr): the ego waits in the
  outer eastbound lane of the east arm (road 1, lane -2) 30 m from the junction; a car comes up
  the inner lane at 10 m/s, passes it, cuts into its lane over 3 s 10 m ahead of it, and slows to
  6 m/s. Run: lagrange_server --robot assets/robots/sedan/sedan.usda --scenario
  assets/scenarios/cut_in.xosc (the roads come from the scenario; the sedan is the ego).
-->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-10-25T00:00:00" description="cut-in" author="Lagrange"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="TargetSpeed" parameterType="double" value="10"/>
    <ParameterDeclaration name="CutInAfter" parameterType="double" value="35"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="../worlds/city_block/city_block.xodr"/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="sedan" vehicleCategory="car">
        <BoundingBox>
          <Center x="0" y="0" z="0.75"/>
          <Dimensions width="1.8" length="4.6" height="1.5"/>
        </BoundingBox>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Target">
      <Vehicle name="car" vehicleCategory="car">
        <BoundingBox>
          <Center x="0" y="0" z="0.75"/>
          <Dimensions width="1.8" length="4.5" height="1.5"/>
        </BoundingBox>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position><LanePosition roadId="1" laneId="-2" s="30" offset="0"/></Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Target">
          <PrivateAction>
            <TeleportAction>
              <Position><LanePosition roadId="1" laneId="-1" s="5" offset="0"/></Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="$TargetSpeed"/></SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="cut_in">
      <Act name="act">
        <ManeuverGroup name="target" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Target"/></Actors>
          <Maneuver name="cut_in">
            <Event name="change_lane" priority="overwrite">
              <Action name="change_lane">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="3" dynamicsDimension="time"/>
                      <LaneChangeTarget><RelativeTargetLane entityRef="Ego" value="0"/></LaneChangeTarget>
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="passed" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Target"/></TriggeringEntities>
                      <EntityCondition><TraveledDistanceCondition value="$CutInAfter"/></EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="slow_down" priority="parallel">
              <Action name="slow_down">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="2" dynamicsDimension="time"/>
                      <SpeedActionTarget><AbsoluteTargetSpeed value="6"/></SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="in_front" delay="0" conditionEdge="none">
                    <ByValueCondition><SimulationTimeCondition value="6.5" rule="greaterThan"/></ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="start" delay="0" conditionEdge="none">
              <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="end" delay="0" conditionEdge="rising">
          <ByValueCondition><SimulationTimeCondition value="12" rule="greaterThan"/></ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
