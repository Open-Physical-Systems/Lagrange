<?xml version="1.0"?>
<!--
  The city block's buildings (robot-classes.md, v0.6): twelve buildings set back from the
  roads and four poles at the junction's corners, fixed to the ground (root link "world"),
  primitives only. The roads come from city_block.xodr; city_block.usda puts the two together.
-->
<robot name="city_block">
  <material name="building"><color rgba="0.72 0.68 0.6 1"/></material>
  <material name="metal"><color rgba="0.35 0.36 0.38 1"/></material>
  <link name="world"/>
  <link name="building_ne_tower">
    <visual>
      <geometry><box size="16 16 30"/></geometry>
      <material name="building"/>
    </visual>
    <collision>
      <geometry><box size="16 16 30"/></geometry>
    </collision>
  </link>
  <joint name="building_ne_tower_fixed" type="fixed">
    <parent link="world"/>
    <child link="building_ne_tower"/>
    <origin xyz="22 22 15.15"/>
  </joint>
  <link name="building_ne_low">
    <visual>
      <geometry><box size="20 14 9"/></geometry>
      <material name="building"/>
    </visual>
    <collision>
      <geometry><box size="20 14 9"/></geometry>
    </collision>
  </link>
  <joint name="building_ne_low_fixed" type="fixed">
    <parent link="world"/>
    <child link="building_ne_low"/>
    <origin xyz="46 21 4.65"/>
  </joint>
  <link name="building_ne_rear">
    <visual>
      <geometry><box size="30 18 14"/></geometry>
      <material name="building"/>
    </visual>
    <collision>
      <geometry><box size="30 18 14"/></geometry>
    </collision>
  </link>
  <joint name="building_ne_rear_fixed" type="fixed">
    <parent link="world"/>
    <child link="building_ne_rear"/>
    <origin xyz="32 46 7.15"/>
  </joint>
  <link name="building_nw_hall">
