<?xml version="1.0"?>
<!--
  A city block for the car samples (robot-classes.md, v0.6): two 14 m roads crossing at the
  origin with centre and stop lines (visual, flush with the ground), raised pavements in the
  four corners, twelve buildings set back 12 m from the junction and four poles at its corners.
  The sample sedan's demo circle (5 m round the origin) fits in the junction. Fixed to the ground
  (root link "world"); primitives only.
-->
<robot name="city_block">
  <material name="asphalt"><color rgba="0.18 0.18 0.19 1"/></material>
  <material name="paint"><color rgba="0.92 0.92 0.88 1"/></material>
  <material name="pavement"><color rgba="0.62 0.6 0.56 1"/></material>
  <material name="building"><color rgba="0.72 0.68 0.6 1"/></material>
  <material name="metal"><color rgba="0.35 0.36 0.38 1"/></material>
  <link name="world"/>
  <link name="road_east_west">
    <visual>
      <geometry><box size="140 14 0.01"/></geometry>
      <material name="asphalt"/>
    </visual>
  </link>
  <joint name="road_east_west_fixed" type="fixed">
    <parent link="world"/>
    <child link="road_east_west"/>
    <origin xyz="0 0 0.005"/>
  </joint>
  <link name="road_north_south">
    <visual>
      <geometry><box size="14 140 0.01"/></geometry>
      <material name="asphalt"/>
    </visual>
  </link>
  <joint name="road_north_south_fixed" type="fixed">
    <parent link="world"/>
    <child link="road_north_south"/>
    <origin xyz="0 0 0.006"/>
  </joint>
