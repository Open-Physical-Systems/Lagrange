    <collision>
      <geometry><box size="22 18 12"/></geometry>
    </collision>
  </link>
  <joint name="building_nw_hall_fixed" type="fixed">
    <parent link="world"/>
    <child link="building_nw_hall"/>
    <origin xyz="-25 23 6.15"/>
  </joint>
  <link name="building_nw_flats">
