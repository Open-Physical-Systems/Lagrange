#usda 1.0
(
    defaultPrim = "orchard"
    doc = "A sample orchard for agricultural drone runs: 8 rows of 15 fruit trees (apple, pear, cherry), a forest edge, 140 TreeAPI_1 trees in all, mown alleys, tall grass, a landing pad. Written by make_orchard.py; no real place."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "orchard"
{
    def Scope "looks"
    {
        def Material "lawn"
        (
            prepend apiSchemas = ["SensorMaterialAPI_1"]
        )
        {
            uniform token sensmat:preset = "grass"
            token outputs:surface.connect = </orchard/looks/lawn/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.38, 0.14)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "tall_grass"
        (
            prepend apiSchemas = ["SensorMaterialAPI_1"]
        )
        {
            uniform token sensmat:preset = "tall_grass"
            token outputs:surface.connect = </orchard/looks/tall_grass/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.42, 0.18)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "soil"
        {
            token outputs:surface.connect = </orchard/looks/soil/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.29, 0.2)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "pad"
        {
            token outputs:surface.connect = </orchard/looks/pad/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.55, 0.15)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
        def Material "mark"
        {
            token outputs:surface.connect = </orchard/looks/mark/surface.outputs:surface>
            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.96, 0.94)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }
