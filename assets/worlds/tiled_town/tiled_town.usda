#usda 1.0
(
    defaultPrim = "tiled_town"
    doc = """The tiled town (huge-worlds.md section 2), written by make_tiled_town.py:
    a 2048 m square town streamed in tiles. 4 coarse tiles of 1024 m (visual only)
    and 64 tiles of 256 m with the buildings as colliders; the server loads them
    around the robot as it drives. The ground is the plane the loader adds."""
