#!/bin/sh
#
# @name Lagrange quad_x500 (SITL)
#
# @type Quadrotor x
#
# The sample quadcopter of Lagrange (assets/robots/quad_x500), flown through lagrange_server's
# MAVLink bridge (--mavlink px4). Rotor positions in FRD (x forward, y right), metres; the moment
# coefficient KM = CP·D/(2π·CT) = 0.0507·0.254/(2π·0.125) of the APC 10x4.7 SF propeller,
# positive for counter-clockwise rotors. The bridge's ESCs make rotor speed proportional to the
# output, so thrust goes with its square (THR_MDL_FAC 1); the hover output is about 0.65.

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.177
param set-default CA_ROTOR0_PY 0.177
param set-default CA_ROTOR0_KM 0.0164
param set-default CA_ROTOR1_PX -0.177
param set-default CA_ROTOR1_PY -0.177
param set-default CA_ROTOR1_KM 0.0164
param set-default CA_ROTOR2_PX 0.177
param set-default CA_ROTOR2_PY -0.177
param set-default CA_ROTOR2_KM -0.0164
param set-default CA_ROTOR3_PX -0.177
param set-default CA_ROTOR3_PY 0.177
param set-default CA_ROTOR3_KM -0.0164

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

param set-default THR_MDL_FAC 1.0
param set-default MPC_THR_HOVER 0.65
