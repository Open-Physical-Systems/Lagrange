<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_ros2_control</name>
  <version>0.3.0</version>
  <description>ros2_control for the Lagrange simulator: the LagrangeSystem hardware plugin and a controller manager stepped by the scheduler in lockstep, with a joint servo for velocity and position commands.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>rclcpp</depend>
  <depend>controller_manager</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>tinyxml2</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lagrange_electrical</test_depend>
  <test_depend>forward_command_controller</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
