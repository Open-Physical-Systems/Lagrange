<?xml version="1.0"?>
<!-- MoveIt semantic description of the sample arm (assets/robots/arm6/arm6.urdf): planning groups,
     named poses for the pick-and-place cycle, and the collision pairs MoveIt need not check. -->
<robot name="arm6">
  <group name="arm">
    <chain base_link="base_link" tip_link="palm_link"/>
  </group>
  <group name="gripper">
    <joint name="finger_left_joint"/>
    <joint name="finger_right_joint"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="0"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="pick_approach" group="arm">
    <joint name="shoulder_pan_joint" value="0.4266"/>
    <joint name="shoulder_lift_joint" value="0.4736"/>
    <joint name="elbow_joint" value="0.9005"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.7675"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="pick" group="arm">
    <joint name="shoulder_pan_joint" value="0.4266"/>
    <joint name="shoulder_lift_joint" value="0.4517"/>
    <joint name="elbow_joint" value="1.1653"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.5246"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="place_approach" group="arm">
    <joint name="shoulder_pan_joint" value="-0.4266"/>
    <joint name="shoulder_lift_joint" value="0.4736"/>
    <joint name="elbow_joint" value="0.9005"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.7675"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="place" group="arm">
    <joint name="shoulder_pan_joint" value="-0.4266"/>
    <joint name="shoulder_lift_joint" value="0.4517"/>
    <joint name="elbow_joint" value="1.1653"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.5246"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="finger_left_joint" value="0.035"/>
    <joint name="finger_right_joint" value="0.035"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="finger_left_joint" value="0.0"/>
    <joint name="finger_right_joint" value="0.0"/>
  </group_state>
  <end_effector name="hand" parent_link="palm_link" group="gripper" parent_group="arm"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="palm_link" reason="Adjacent"/>
  <disable_collisions link1="palm_link" link2="finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="palm_link" link2="finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="finger_left_link" link2="finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="palm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Adjacent"/>
</robot>
