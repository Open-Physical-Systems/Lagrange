<?xml version="1.0"?>
<!-- A flywheel on a fixed base, turned by a motor. The <lagrange> block names the netlist and says
     what SPICE cannot: what the battery holds, where the bus trips, which joint the motor turns.
     Other URDF readers skip the block. Sizes are illustrative. -->
<robot name="flywheel">
  <link name="world"/>
  <joint name="mount" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.3"/>
  </joint>
  <link name="base_link">
    <inertial>
      <mass value="5"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry></visual>
  </link>
  <link name="wheel">
    <inertial>
      <mass value="4"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.18" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.3" length="0.03"/></geometry>
    </visual>
  </link>
  <joint name="spin" type="continuous">
    <parent link="base_link"/>
    <child link="wheel"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="30"/>
  </joint>
  <lagrange>
    <schematic file="power.cir"/>
    <battery source="V_pack" capacity="72000" cutoff="18" max_charge="10"/>
    <bus node="dc" undervoltage="15" overvoltage="30"/>
    <motor joint="spin" node="dc" r="0.2" l="0.0003" kt="0.1" imax="20" gear="10" rotor_inertia="0.0001"/>
  </lagrange>
</robot>
