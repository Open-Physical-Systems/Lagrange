<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_examples_check</name>
  <version>1.0.0</version>
  <description>Runs every Lagrange example through its launch file and checks its result.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>lagrange_example_diff_drive</test_depend>
  <test_depend>lagrange_example_arm</test_depend>
  <test_depend>lagrange_example_power</test_depend>
  <test_depend>lagrange_example_lidar</test_depend>
  <test_depend>lagrange_example_weather</test_depend>
  <test_depend>lagrange_example_quadcopter</test_depend>
  <test_depend>lagrange_example_car</test_depend>
  <test_depend>lagrange_example_spawn</test_depend>
  <test_depend>lagrange_example_ros2_control</test_depend>
  <test_depend>lagrange_example_plugin</test_depend>
  <test_depend>lagrange_example_rl</test_depend>
  <test_depend>lagrange_example_quadruped</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
