<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_gpu</name>
  <version>1.2.1</version>
  <description>Lagrange GPU layer: Vulkan device abstraction, capability tiers, and Slang shader build support. All Vulkan use in the project goes through this package.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>
  <!-- Keys for slang-compiler and the allocator are defined in packaging/rosdep/lagrange.yaml. -->
  <buildtool_depend>slang-compiler</buildtool_depend>
  <buildtool_export_depend>slang-compiler</buildtool_export_depend>

  <depend>libjpeg</depend>
  <depend>libvulkan-dev</depend>
  <build_depend>libvulkan-memory-allocator-dev</build_depend>
  <depend>zlib</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>mesa-vulkan-drivers</test_depend>
  <test_depend>libopencv-dev</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
