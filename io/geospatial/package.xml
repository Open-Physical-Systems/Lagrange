<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_geospatial</name>
  <version>1.0.0</version>
  <description>Large worlds from open data (v0.7): terrain from elevation models through GDAL and PROJ, buildings and roads from OpenStreetMap, 3D Tiles for show, written as streamed WorldTileAPI_1 tiles (lagrange_build_world).</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>lagrange_stage</depend>
  <depend>lagrange_meshes</depend>
  <depend>libgdal-dev</depend>
  <depend>tinyxml2</depend>
  <build_depend>libjsoncons-dev</build_depend>
  <exec_depend>proj-data</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
