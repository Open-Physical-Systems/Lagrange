<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_opendrive</name>
  <version>1.1.0</version>
  <description>OpenDRIVE road networks: an own reader for geometry and lanes, and their conversion to USD road surfaces, road marks and RoadLaneAPI_1 lanes (v0.6).</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>lagrange_stage</depend>
  <depend>tinyxml2</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
