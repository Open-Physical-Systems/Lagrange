<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_openscenario</name>
  <version>1.0.0</version>
  <description>OpenSCENARIO: an own reader and runner for a subset of OpenSCENARIO 1.x (entities, Init, stories, speed and lane-change actions, conditions) on the road lanes (v0.6).</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>tinyxml2</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lagrange_opendrive</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
