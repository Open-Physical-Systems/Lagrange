<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_aerodynamics</name>
  <version>1.3.0</version>
  <description>The aerodynamics domain: link drag against the wind, its logarithmic profile and Dryden turbulence (v0.4).</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>lagrange_fields</depend>
  <depend>tbb</depend>
  <depend>lagrange_gpu</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
