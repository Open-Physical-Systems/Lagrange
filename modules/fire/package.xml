<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_fire</name>
  <version>1.4.0</version>
  <description>Fire (RFC 0022): heat release rate, flame, radiant heat into thermal nodes, spread, smoke, and putting fires out with water, foam and wind, by fire engineering correlations.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>lagrange_fields</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lagrange_thermal</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
