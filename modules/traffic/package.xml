<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_traffic</name>
  <version>0.7.0</version>
  <description>The traffic domain, builtin backend: lane-following vehicles (IDM), pedestrians on sidewalks (social force) and fixed-cycle traffic lights, as kinematic bodies (v0.6).</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lagrange_rigid_body_mujoco</test_depend>
  <test_depend>lagrange_opendrive</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
