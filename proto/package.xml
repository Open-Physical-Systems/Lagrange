<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_proto</name>
  <version>0.3.0</version>
  <description>Lagrange viewer protocol: Protobuf message definitions with generated C++ and Python code.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <build_depend>libxxhash-dev</build_depend>
  <depend>protobuf-dev</depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-protobuf</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
