<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_python</name>
  <version>1.3.0</version>
  <description>Python bindings (nanobind): run a simulation headless from Python, step it, and read its signals and world.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <build_depend>nanobind-dev</build_depend>
  <depend>lagrange_server</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>lagrange_assets</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>lagrange_proto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
