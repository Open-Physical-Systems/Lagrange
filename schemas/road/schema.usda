#usda 1.0
(
    """Lagrange road schemas (RFC 0002, docs/design/formats.md section 3.11). Codeless.
    RoadLaneAPI_1 makes a prim one lane of a road network (from OpenDRIVE, io/opendrive): its
    centre line in the direction of travel and its links, for traffic and planners.
    RoadSignalAPI_1 makes a prim one traffic light (an OpenDRIVE dynamic signal): the lanes it
    governs, where vehicles stop for it, and the controller it turns with."""
    subLayers = [ @usd/schema.usda@ ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "lagrangeRoad"
        string libraryPath = "."
        bool skipCodeGeneration = true
    }
)
{
}

class "RoadLaneAPI_1" (
    inherits = </APISchemaBase>
    doc = """One lane of one lane section of a road, in its direction of travel (OpenDRIVE: right
    lanes along the reference line, left lanes against it, for right-hand traffic)."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double[] lane:centreLine = [] (
        lagrangeUnit = "m"
        doc = "Points of the lane's centre line, x y z after one another, region-local, in the direction of travel. Required."
    )
    double[] lane:width = [] (
        lagrangeUnit = "m"
        doc = "The lane's width at each centre-line point."
    )
    uniform token lane:type = "driving" (
        allowedTokens = ["driving", "sidewalk", "biking", "parking", "other"]
        doc = "What the lane is for."
    )
    double lane:speedLimit = 0 (
        lagrangeUnit = "m/s"
        doc = "Speed limit; 0: none given."
    )
    int lane:road = 0 (
        lagrangeUnit = "1"
        doc = "The OpenDRIVE road id."
    )
    int lane:lane = 0 (
        lagrangeUnit = "1"
        doc = "The OpenDRIVE lane id (negative: right of the reference line)."
    )
    double lane:sStart = 0 (
        lagrangeUnit = "m"
        doc = "Where along its road (OpenDRIVE s) the lane section starts."
    )
    double lane:sEnd = 0 (
        lagrangeUnit = "m"
        doc = "Where along its road the lane section ends."
    )
    bool lane:junction = false (
        doc = "A lane of a junction's connecting road."
    )
    rel lane:successors (
        doc = "Lanes a vehicle can continue into at the end."
    )
    rel lane:predecessors (
        doc = "Lanes that lead into this one."
    )
}

class "RoadSignalAPI_1" (
    inherits = </APISchemaBase>
    doc = """A traffic light: an OpenDRIVE dynamic <signal> (ASAM OpenDRIVE 1.8 section 14) with
    its validity and controller. The prim's pose is the middle of the light's face, its x axis
    out of the face towards the traffic it governs. Vehicles on the lanes it governs stop where
    it stands along the road (signal:s); the signals of one controller turn green together, and
    a junction's controllers take turns in their signal:sequence order."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    string signal:id = "" (
        doc = "The OpenDRIVE signal id."
    )
    int signal:road = 0 (
        lagrangeUnit = "1"
        doc = "The OpenDRIVE road id the signal stands on."
    )
    double signal:s = 0 (
        lagrangeUnit = "m"
        doc = "Where along its road (OpenDRIVE s) it stands: the stop line of the lanes it governs."
    )
    double signal:t = 0 (
        lagrangeUnit = "m"
        doc = "Its lateral offset from the road's reference line, positive to the left."
    )
    uniform token signal:orientation = "+" (
        allowedTokens = ["+", "-", "none"]
        doc = "The traffic it applies to: + along s (right lanes), - against s (left lanes), none both."
    )
    string signal:type = "" (
        doc = "The OpenDRIVE signal type (country specific, e.g. 1000001 for a three-lamp light)."
    )
    string signal:subtype = "" (
        doc = "The OpenDRIVE signal subtype."
    )
    int signal:fromLane = 0 (
        lagrangeUnit = "1"
        doc = "The first lane id it governs (OpenDRIVE validity); with signal:toLane 0 as well: every driving lane of its orientation's side."
    )
    int signal:toLane = 0 (
        lagrangeUnit = "1"
        doc = "The last lane id it governs (OpenDRIVE validity)."
    )
    string signal:controller = "" (
        doc = "The OpenDRIVE controller that switches it; empty: none, it turns on its own."
    )
    int signal:junction = -1 (
        lagrangeUnit = "1"
        doc = "The OpenDRIVE junction whose controller list names its controller; -1: none."
    )
    int signal:sequence = -1 (
        lagrangeUnit = "1"
        doc = "Its controller's sequence in that junction: lower turns green first; -1: none given (then by controller id)."
    )
    double signal:height = 0 (
        lagrangeUnit = "m"
        doc = "The light's head height; its lamps stand a third of it apart. 0: not given (1 m)."
    )
}
