#usda 1.0
(
    """Lagrange sensor schemas (RFC 0002, docs/design/formats.md section 3.8). Codeless: the
    stage loader reads the attributes by name. Units: the lagrangeUnit field of each attribute."""
    subLayers = [ @usd/schema.usda@ ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "lagrangeSensor"
        string libraryPath = "."
        bool skipCodeGeneration = true
    }
)
{
}

class "SensorAPI_1" (
    inherits = </APISchemaBase>
    doc = """Common properties of a simulated sensor. The sensor's frame is the prim's frame; its
    body is the nearest ancestor with PhysicsRigidBodyAPI."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:rate (
        lagrangeUnit = "Hz"
        doc = "Output rate. Required."
    )
    double sensor:latency = 0 (
        lagrangeUnit = "s"
        doc = "Delay from sampling to output."
    )
    double sensor:jitter = 0 (
        lagrangeUnit = "s"
        doc = "Standard deviation of the output time."
    )
    string sensor:frameId = "" (
        doc = "Frame name for ROS messages; empty: the prim name."
    )
    string sensor:topic = "" (
        doc = "ROS topic; empty: derived from the sensor kind and name."
    )
}

class "LidarAPI_1" (
    inherits = </APISchemaBase>
    doc = """A scanning lidar: channels rings across verticalFov, horizontalSamples columns
    across horizontalFov. One channel is a 2D scanner. Apply with SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    int sensor:lidar:channels = 1 (
        lagrangeUnit = "1"
        doc = "Rings (vertical samples)."
    )
    int sensor:lidar:horizontalSamples (
        lagrangeUnit = "1"
        doc = "Columns per scan. Required."
    )
    double2 sensor:lidar:horizontalFov = (-3.141592653589793, 3.141592653589793) (
        lagrangeUnit = "rad"
        doc = "First and last column's azimuth about the sensor's z."
    )
    double2 sensor:lidar:verticalFov = (0, 0) (
        lagrangeUnit = "rad"
        doc = "Lowest and highest ring's elevation above the sensor's xy plane."
    )
    double sensor:lidar:rangeMin (
        lagrangeUnit = "m"
        doc = "Returns nearer than this are dropped. Required."
    )
    double sensor:lidar:rangeMax (
        lagrangeUnit = "m"
        doc = "Returns further than this are dropped. Required."
    )
    double sensor:lidar:rangeNoiseStd = 0.02 (
        lagrangeUnit = "m"
        doc = "Standard deviation of Gaussian range noise."
    )
    bool sensor:lidar:motionDistortion = true (
        doc = "Each column fires from where the sensor is at its moment in the scan."
    )
    double sensor:lidar:wavelength = 9.05e-7 (
        lagrangeUnit = "m"
    )
    double sensor:lidar:beamDivergence = 0.003 (
        lagrangeUnit = "rad"
    )
    uniform token sensor:lidar:returnMode = "strongest" (
        allowedTokens = ["strongest", "last", "dual"]
    )
    uniform token sensor:lidar:scanPattern = "rotating" (
        allowedTokens = ["rotating", "solid_state", "custom"]
    )
}

class "ImuAPI_1" (
    inherits = </APISchemaBase>
    doc = """An inertial measurement unit: specific force and angular rate in the prim's frame.
    Noise is white, per sample (the noise densities of formats.md wait for half powers in the
    unit grammar). Apply with SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:imu:accelNoiseStd = 0 (
        lagrangeUnit = "m/s2"
        doc = "Standard deviation of each specific-force sample."
    )
    double sensor:imu:gyroNoiseStd = 0 (
        lagrangeUnit = "rad/s"
        doc = "Standard deviation of each angular-rate sample."
    )
    double sensor:imu:accelBiasInstability = 0 (
        lagrangeUnit = "m/s2"
    )
    double sensor:imu:gyroBiasInstability = 0 (
        lagrangeUnit = "rad/s"
    )
}

class "CameraSensorAPI_1" (
    inherits = </APISchemaBase>
    doc = """A camera: apply to a UsdGeomCamera with SensorAPI_1. The camera's lens comes from
    UsdGeomCamera (focalLength, horizontalAperture, clippingRange); it looks along its -z with y
    up. The raster level draws colour, depth and instance ids; the sensor-model attributes below
    (exposure, noise, distortion, rolling shutter) take effect at the sensor_model level
    (docs/design/domains/sensors.md section 2)."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    int sensor:camera:width (
        lagrangeUnit = "1"
        doc = "Image width in pixels. Required."
    )
    int sensor:camera:height (
        lagrangeUnit = "1"
        doc = "Image height in pixels. Required."
    )
    uniform token sensor:camera:shutter = "global" (
        allowedTokens = ["global", "rolling"]
    )
    double sensor:camera:rollingShutterTime = 0 (
        lagrangeUnit = "s"
        doc = "Time from the first row's exposure to the last's."
    )
    double sensor:camera:exposureTime (
        lagrangeUnit = "s"
        doc = """Exposure time; with autoExposure the longest one. No fallback: the sensor model
        (exposure and noise) runs when it is given."""
    )
    double sensor:camera:electronRate (
        lagrangeUnit = "1/s"
        doc = """Electrons per second a pixel collects from what the renderer draws at full
        brightness (linear 1): the scene's light level for this camera, which the raster level does
        not model. Required with exposureTime."""
    )
    double sensor:camera:vignetting = 0 (
        lagrangeUnit = "1"
        doc = "Fraction of the natural cos⁴θ fall-off applied (0: none, 1: all of it)."
    )
    bool sensor:camera:autoExposure = false
    double sensor:camera:gain = 1 (
        lagrangeUnit = "1"
    )
    double sensor:camera:readNoiseStd = 2 (
        lagrangeUnit = "1"
        doc = "Read noise in electrons."
    )
    double sensor:camera:fullWellCapacity = 10000 (
        lagrangeUnit = "1"
        doc = "Electrons."
    )
    int sensor:camera:bitDepth = 8 (
        lagrangeUnit = "1"
    )
    uniform token sensor:camera:distortionModel = "none" (
        allowedTokens = ["none", "plumb_bob", "equidistant"]
    )
    double[] sensor:camera:distortionCoeffs = [] (
        lagrangeUnit = "1"
        doc = "OpenCV order: k1, k2, p1, p2, k3 for plumb_bob; k1 to k4 for equidistant."
    )
}

class "GnssAPI_1" (
    inherits = </APISchemaBase>
    doc = """A GNSS receiver: WGS84 position and ENU velocity of the antenna (the prim's origin),
    placed on the Earth through the world's geo origin. Noise is white, per fix. Apply with
    SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:gnss:horizontalNoiseStd = 0 (
        lagrangeUnit = "m"
        doc = "Standard deviation of each horizontal position component."
    )
    double sensor:gnss:verticalNoiseStd = 0 (
        lagrangeUnit = "m"
        doc = "Standard deviation of the height."
    )
    double sensor:gnss:velocityNoiseStd = 0 (
        lagrangeUnit = "m/s"
        doc = "Standard deviation of each velocity component."
    )
}

class "MagnetometerAPI_1" (
    inherits = </APISchemaBase>
    doc = """A three-axis magnetometer: the Earth's main field (World Magnetic Model) in the prim's
    frame. Noise is white, per sample. Apply with SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:magnetometer:noiseStd = 0 (
        lagrangeUnit = "T"
        doc = "Standard deviation of each axis."
    )
}

class "BarometerAPI_1" (
    inherits = </APISchemaBase>
    doc = """A barometer: static pressure and air temperature at the prim's height (the standard
    atmosphere until a weather model gives the site's). Noise is white, per sample. Apply with
    SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:barometer:noiseStd = 0 (
        lagrangeUnit = "Pa"
        doc = "Standard deviation of the pressure."
    )
}

class "RadarAPI_1" (
    inherits = </APISchemaBase>
    doc = """An automotive radar (domains/sensors.md): rays launched over its field of view, a
    detection per object whose echo beats the threshold above the noise floor, with range,
    azimuth, elevation, radial velocity and radar cross-section. The prim's +x looks forward. Apply
    with SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double sensor:radar:carrierFrequency = 77000000000 (
        lagrangeUnit = "Hz"
        doc = "Carrier frequency (77 GHz: the automotive band)."
    )
    double sensor:radar:rangeMax (
        lagrangeUnit = "m"
        doc = "Largest range reported. Required."
    )
    double sensor:radar:azimuthFov (
        lagrangeUnit = "rad"
        doc = "Horizontal field of view, centred on +x. Required."
    )
    double sensor:radar:elevationFov (
        lagrangeUnit = "rad"
        doc = "Vertical field of view. Required."
    )
    double sensor:radar:azimuthResolution = 0.035 (
        lagrangeUnit = "rad"
        doc = "Angular resolution: the rays' spacing is half of it."
    )
    double sensor:radar:rangeResolution = 0.2 (
        lagrangeUnit = "m"
        doc = "Range resolution (c/2B)."
    )
    double sensor:radar:velocityResolution = 0.1 (
        lagrangeUnit = "m/s"
        doc = "Radial velocity resolution."
    )
    double sensor:radar:txPower (
        lagrangeUnit = "W"
        doc = "Transmit power. Required."
    )
    double sensor:radar:antennaGain = 1 (
        lagrangeUnit = "1"
        doc = "Linear antenna gain (the same for transmit and receive)."
    )
    double sensor:radar:noiseFloor (
        lagrangeUnit = "W"
        doc = """Effective noise power the echo is compared with: the receiver's k·T·B·F less the
        processing gain of its chirps and samples (the radar equation here has no integration
        term). Required."""
    )
    double sensor:radar:detectionThreshold = 10 (
        lagrangeUnit = "1"
        doc = "Signal-to-noise ratio a detection needs (linear; 10: 10 dB)."
    )
}

class "CustomSensorAPI_1" (
    inherits = </APISchemaBase>
    doc = """A sensor that Lagrange does not simulate itself: a plugin implements its kind
    (RFC 0008 section 3). Its parameters are attributes named sensor:custom:param:<name>, of type
    double or string, any number of them (a ':' in <name> stands for '/' in the parameter's path:
    sensor:custom:param:range:max is "range/max"). Apply with SensorAPI_1."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    string sensor:custom:kind (
        doc = """The kind of sensor ("sonar", "tof", "gas"): what a plugin looks for. Required."""
    )
}
