#usda 1.0
(
    """Lagrange world schemas (RFC 0002, docs/design/huge-worlds.md section 2). Codeless.
    WorldTileAPI_1 makes a prim one tile of a large world: a payload the server loads and
    unloads while the simulation runs, near the robots that need it."""
    subLayers = [ @usd/schema.usda@ ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "lagrangeWorld"
        string libraryPath = "."
        bool skipCodeGeneration = true
    }
)
{
}

class "WorldTileAPI_1" (
    inherits = </APISchemaBase>
    doc = """One tile of a tiled world, on a prim whose payload holds the tile's content
    (terrain, buildings, roads, props), authored relative to the prim's own translation. The
    stage opens with every payload unloaded; the server loads a tile when a robot comes within
    the streaming load radius and drops it beyond the unload radius."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    int world:tile:level = 0 (
        lagrangeUnit = "1"
        doc = "Level of detail: 0 is the coarsest. A finer level replaces the coarser tiles it overlaps once loaded."
    )
    int2 world:tile:index = (0, 0) (
        lagrangeUnit = "1"
        doc = "Index of the tile in its level's grid, east then north."
    )
    double3 world:tile:boundsMin = (0, 0, 0) (
        lagrangeUnit = "m"
        doc = "Lower corner of the tile's content, in the stage's frame (world ENU). Required."
    )
    double3 world:tile:boundsMax = (0, 0, 0) (
        lagrangeUnit = "m"
        doc = "Upper corner of the tile's content, in the stage's frame (world ENU). Required."
    )
    double world:tile:geometricError = 0 (
        lagrangeUnit = "m"
        doc = "How far the tile's geometry may be from the true surface; the selection compares it with the distance to the nearest interest source."
    )
    bool world:tile:hasCollision = false (
        doc = "The tile has colliders: robots may only enter it once they are in the physics backend."
    )
}

class "TreeAPI_1" (
    inherits = </APISchemaBase>
    doc = """A tree (docs/physics/ground.md "Trees") standing at this prim's origin, z up. Its trunk
    is whatever collider the stage gives it; its crown is not a collider but a volume of leaves and
    twigs, an ellipsoid over crownBase with semi-axes (crownRadius, crownRadius,
    (height - crownBase)/2). Bodies push through it, the wind and rotor downwash sway it (one
    damped mode), propellers cut it, and lidars see it as a turbid volume."""
    customData = {
        token apiSchemaType = "singleApply"
    }
)
{
    double tree:height (
        lagrangeUnit = "m"
        doc = "From the foot of the trunk to the top of the crown. Required."
    )
    double tree:crownRadius (
        lagrangeUnit = "m"
        doc = "The crown's horizontal semi-axis. Required."
    )
    double tree:crownBase (
        lagrangeUnit = "m"
        doc = "Where the crown starts over the foot. No fallback: 0.3 of the height."
    )
    double tree:trunkDiameter (
        lagrangeUnit = "m"
        doc = "For drawing. No fallback: an eighth of the crown radius."
    )
    double tree:leafAreaDensity = 1 (
        lagrangeUnit = "m2/m3"
        doc = "Leaf area per crown volume: the drag on what moves through it and the lidars' gap probability."
    )
    double tree:dragCoefficient = 0.3 (
        lagrangeUnit = "1"
        doc = "Of the crown's side area pi·crownRadius·(height - crownBase)/2, for its sway."
    )
    double tree:naturalFrequency = 0.5 (
        lagrangeUnit = "Hz"
        doc = "The first sway mode's."
    )
    double tree:dampingRatio = 0.1 (
        lagrangeUnit = "1"
        doc = "The first sway mode's."
    )
    double tree:crownMass (
        lagrangeUnit = "kg"
        doc = "The sway mode's mass. No fallback: 2 kg per m3 of crown."
    )
    double tree:cutEnergy = 2000 (
        lagrangeUnit = "J/m3"
        doc = "The energy a propeller spends cutting through a cubic metre of crown."
    )
    double tree:leafArea = 0.003 (
        lagrangeUnit = "m2"
        doc = "One leaf's area, to count the leaves a cut sheds."
    )
}
