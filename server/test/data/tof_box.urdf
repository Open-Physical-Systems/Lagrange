<?xml version="1.0"?>
<!-- A box with a time-of-flight sensor looking 0.5 rad down at the ground (RFC 0008 §3 test). -->
<robot name="tof_box">
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.083" iyy="0.083" izz="0.133" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual><geometry><box size="0.4 0.4 0.2"/></geometry></visual>
    <collision><geometry><box size="0.4 0.4 0.2"/></geometry></collision>
  </link>
  <gazebo reference="base_link">
    <sensor name="front_tof" type="tof">
      <pose>0.15 0 0.1 0 0.5 0</pose>
      <update_rate>50</update_rate>
      <tof>
        <range><min>0.02</min><max>4</max></range>
        <fov>0</fov>
        <noise><type>gaussian</type><stddev>0</stddev></noise>
      </tof>
    </sensor>
  </gazebo>
</robot>
