<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_tutorial</name>
  <version>0.4.0</version>
  <description>The code of the user guide (docs/guide/): the Odometer module of "Writing a module", a program that runs it on the sample AMR, and tests that keep both working.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_core</depend>
  <depend>lagrange_rigid_body_mujoco</depend>
  <depend>lagrange_server</depend>
  <depend>lagrange_electrical</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>lagrange_assets</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
