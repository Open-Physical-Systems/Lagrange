# LeakSanitizer suppressions for the sanitizer builds.
#
# OpenUSD keeps process-lifetime registries (Sdf_IdRegistryImpl, TfType, the plugin and schema
# registries) that it deliberately never frees. It is a Release dependency, not code under test.
leak:libusd_ms.so

# ROS 2 keeps per-process logging and context state until exit; it is not code under test.
leak:librcl.so
leak:librclcpp.so
# Jolt's type registration is once per process, on purpose (initJolt).
leak:JPH::RegisterTypesInternal
# Mesa's and NVIDIA's Vulkan drivers, seen through libdrm and libdisplay-info.
leak:libdrm.so
leak:libdisplay-info.so
