def asset_fetched(asset_id: str) -> bool:
    root = os.environ.get("LAGRANGE_ASSET_DIR") or str(
        Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
        / "lagrange"
        / "assets"
    )
    return (Path(root) / asset_id / "NOTICE").is_file()


def usage() -> None:
    print(__doc__.strip().split("\n", 1)[1].strip("\n"))
    print("\nSamples:", ", ".join(samples()), "(lagrange samples)")
    print("Server options: lagrange_server --help; viewer options: lagrange viewer --help.")
    print(
        "Examples:\n  lagrange\n  lagrange sedan\n  lagrange robot.urdf world.sdf --spawn 2,0"
        "\n  lagrange empty   (then, in another terminal: lagrange spawn robot.urdf --at 0,0)"
        "\n  lagrange --robot robot.usda --world none -- --follow 5"
    )


def own_endpoint() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/lagrange-{os.getuid()}"
    directory = Path(runtime) / "lagrange"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    return f"unix:{directory}/run-{os.getpid()}.sock"


def reachable(endpoint: str) -> bool:
    if endpoint.startswith("unix:"):
        return Path(endpoint[5:]).exists()
    address = endpoint.split("://", 1)[-1]
    host, _, port = address.rpartition(":")
    try:
        with socket.create_connection((host or "127.0.0.1", int(port)), timeout=0.5):
            return True
    except (OSError, ValueError):
        return False


def stop(process: subprocess.Popen[bytes]) -> int:
    if process.poll() is None:
        process.send_signal(signal.SIGTERM)
        try:
            process.wait(timeout=STOP_SECONDS)
        except subprocess.TimeoutExpired:
            process.kill()  # ROS shared memory may need `fastdds shm clean` after this
    return process.wait()


SERVICE_WAIT_SECONDS = 10.0


def call_service(kind: str, name: str, request: Any) -> Any:
    """Calls a simulation_interfaces service of the running simulator and returns the answer."""
    try:
        import rclpy
        from rclpy.node import Node
        from simulation_interfaces import srv
    except ImportError:
        sys.exit("lagrange: rclpy is missing (source the ROS 2 setup first)")
    rclpy.init()
    try:
        node = Node("lagrange_cli")
        client = node.create_client(getattr(srv, kind), name)
        if not client.wait_for_service(timeout_sec=SERVICE_WAIT_SECONDS):
            sys.exit(f"lagrange: no simulator answers {name} (is one running, with ROS?)")
        future = client.call_async(request)
        rclpy.spin_until_future_complete(node, future, timeout_sec=60.0)
        if not future.done():
            sys.exit(f"lagrange: {name} did not answer")
        return future.result()
    finally:
        rclpy.try_shutdown()


def parse_at(text: str) -> list[float]:
    try:
        values = [float(v) for v in text.split(",")]
    except ValueError:
        values = []
    if not 2 <= len(values) <= 4:
        sys.exit("lagrange: --at needs X,Y[,Z[,YAW]] (metres, radians)")
    return values + [0.0] * (4 - len(values))


def spawn(argv: list[str]) -> int:
    import math

    from simulation_interfaces import srv

    path, name, at = "", "", [0.0, 0.0, 0.0, 0.0]
    args = list(argv)
    while args:
        word = args.pop(0)
        if word in ("--name", "--at") and not args:
            sys.exit(f"lagrange: {word} needs a value")
        if word == "--name":
            name = args.pop(0)
        elif word == "--at":
            at = parse_at(args.pop(0))
        elif not path and not word.startswith("-"):
            path = word
        else:
            sys.exit(f"lagrange: unexpected '{word}' (lagrange spawn FILE [--name N] [--at X,Y])")
    if not path:
        sys.exit("lagrange: spawn needs a robot file (URDF, SDFormat, MJCF or USD)")
    if not Path(path).is_file():
        sys.exit(f"lagrange: no file {path}")
    request = srv.SpawnEntity.Request()
    request.name = name
    request.allow_renaming = not name
    request.entity_resource.uri = str(Path(path).resolve())
    request.initial_pose.header.frame_id = "world"
    pose = request.initial_pose.pose
    pose.position.x, pose.position.y, pose.position.z = at[0], at[1], at[2]
    pose.orientation.z, pose.orientation.w = math.sin(at[3] / 2), math.cos(at[3] / 2)
    response = call_service("SpawnEntity", "/spawn_entity", request)
    if response.result.result != 1:  # simulation_interfaces Result.RESULT_OK
        print(f"lagrange: {response.result.error_message}", file=sys.stderr)
        return 1
    print(response.entity_name)
    return 0


def delete(argv: list[str]) -> int:
    from simulation_interfaces import srv

    if len(argv) != 1:
        sys.exit("lagrange: delete needs one entity name (lagrange delete NAME)")
    request = srv.DeleteEntity.Request()
    request.entity = argv[0]
    response = call_service("DeleteEntity", "/delete_entity", request)
    if response.result.result != 1:
        print(f"lagrange: {response.result.error_message}", file=sys.stderr)
        return 1
    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    if argv and argv[0] in TOOLS:
        os.execv(executable("lagrange_server", "lagrange"), ["lagrange", *argv])
    if argv and argv[0] == "viewer":
        viewer = executable("lagrange_viewer", "lagrange_viewer")
        os.execv(viewer, [viewer, *argv[1:]])
    if argv and argv[0] == "spawn":
        return spawn(argv[1:])
    if argv and argv[0] == "delete":
        return delete(argv[1:])
    if argv and argv[0] == "server":
        argv = ["--server-only", *argv[1:]]
    if argv and argv[0] == "samples":
        for name, (text, *_rest) in samples().items():
            print(f"  {name:8} {text}")
        return 0

    server_args, viewer_args = argv, []
    if "--" in argv:
        cut = argv.index("--")
        server_args, viewer_args = argv[:cut], argv[cut + 1 :]
    server_only = False
    for flag in ("--server-only", "-s"):
        while flag in server_args:
            server_args.remove(flag)
            server_only = True

    # A sample by name, or a robot file and a world file as the first words.
    words = []
    while server_args and not server_args[0].startswith("-"):
        words.append(server_args.pop(0))
    chosen = samples()
    if words and words[0] in chosen:
        _text, sample_server, sample_viewer, fetched = chosen[words.pop(0)]
        if fetched and not asset_fetched(fetched):
            print(
                f"lagrange: the meshes of this sample are not fetched; it runs with boxes "
                f"in their place (ros2 run lagrange_assets fetch_assets {fetched})",
                file=sys.stderr,
            )
        server_args = [*sample_server, *server_args]
        viewer_args = [*sample_viewer, *viewer_args]
    if len(words) > 2:
        sys.exit(f"lagrange: unexpected '{words[2]}' (lagrange --help)")
    for flag, word in zip(("--robot", "--world"), words, strict=False):
        if word not in chosen and not Path(word).exists():
            sys.exit(f"lagrange: no sample or file '{word}' (lagrange samples)")
        server_args = [flag, word, *server_args]

    server = executable("lagrange_server", "lagrange_server")
    if server_only:
        os.execv(server, [server, *server_args])

    # The server listens on an endpoint of this run unless told otherwise, so that it never
    # meets another simulator on the default socket.
    if "--listen" in server_args:
        endpoint = server_args[server_args.index("--listen") + 1]
    else:
        endpoint = own_endpoint()
        server_args = [*server_args, "--listen", endpoint]
    if "--connect" not in viewer_args:
        viewer_args = ["--connect", endpoint, *viewer_args]

    server_process = subprocess.Popen([server, *server_args])
    deadline = time.monotonic() + SERVER_START_SECONDS
    while not reachable(endpoint):
        if server_process.poll() is not None:
            return server_process.returncode or 1
        if time.monotonic() > deadline:
            print("lagrange: the server did not start listening", file=sys.stderr)
            return stop(server_process) or 1
        time.sleep(0.1)

    # Ctrl-C reaches both processes (same terminal); wait for them instead of dying first.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    viewer_process = subprocess.Popen(
        [executable("lagrange_viewer", "lagrange_viewer"), *viewer_args],
        preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL),
    )
    while viewer_process.poll() is None and server_process.poll() is None:
        time.sleep(0.2)
    server_ended_first = server_process.poll() is not None
    viewer_status = stop(viewer_process)
    server_status = stop(server_process)
    if endpoint.startswith("unix:"):
        Path(endpoint[5:]).unlink(missing_ok=True)
    if server_ended_first:
        print(f"lagrange: the server stopped (exit {server_status})", file=sys.stderr)
        return server_status or 1
    return viewer_status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
