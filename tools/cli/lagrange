def is_profile(path: str) -> bool:
    """Whether a YAML file is a simulation profile (profiles/schema.json): it has domains:."""
    if not Path(path).is_file():
        return False
    try:
        import yaml

        content = yaml.safe_load(Path(path).read_text())
    except Exception:
        return False
    return isinstance(content, dict) and "domains" in content


def run_file_args(path: str) -> list[str]:
    """The server options a run file stands for. Exits naming what is wrong in it."""
    try:
        import yaml
    except ImportError:
        sys.exit("lagrange: a run file needs PyYAML (apt install python3-yaml)")

    def fail(message: str) -> NoReturn:
        sys.exit(f"lagrange: {path}: {message}")

    try:
        run = yaml.safe_load(Path(path).read_text())
    except (OSError, yaml.YAMLError) as error:
        fail(str(error))
    if not isinstance(run, dict):
        fail("a run file is a mapping: robot: my_robot.urdf")
    if unknown := set(run) - RUN_KEYS:
        fail(f"unknown key {sorted(unknown)[0]}; a run file has {', '.join(sorted(RUN_KEYS))}")
    if "robot" not in run and "world" not in run:
        fail("name a robot or a world: robot: my_robot.urdf")
    base = Path(path).resolve().parent

    def file_of(key: str, value: Any) -> str:
        found = base / str(value)
        if not found.is_file():
            fail(f"{key}: no file {found}")
        return str(found)

    args: list[str] = []
    args += ["--robot", file_of("robot", run["robot"])] if "robot" in run else ["--robot", "none"]
    args += ["--world", file_of("world", run["world"])] if "world" in run else ["--world", "none"]
    if "overlay" in run:
        args += ["--overlay", file_of("overlay", run["overlay"])]
    if "spawn" in run:
        spawn_at = run["spawn"]
        if not isinstance(spawn_at, list) or not 2 <= len(spawn_at) <= 4:
            fail("spawn: [x, y] or [x, y, z] or [x, y, z, yaw]")
        args += ["--spawn", ",".join(str(float(v)) for v in spawn_at)]
    for name, wanted in (run.get("simulate") or {}).items():
        if name not in DOMAIN_OFF:
            fail(f"simulate: unknown {name}; one of {', '.join(sorted(DOMAIN_OFF))}")
        if not isinstance(wanted, bool):
            fail(f"simulate: {name} is true or false")
        args += ["--domain", f"{DOMAIN_OFF[name]}={'on' if wanted else 'off'}"]
    site = dict(run.get("site") or {})
    if "geo_origin" in site:
        origin = site.pop("geo_origin")
        args += ["--geo-origin", ",".join(str(float(v)) for v in origin)]
    for key, value in site.items():
        if key not in SITE_KEYS:
            fail(f"site: unknown {key}; one of {', '.join(sorted({*SITE_KEYS, 'geo_origin'}))}")
        args += ["--site", f"{key}={float(value)}"]
    if "physics" in run:
        args += ["--physics", str(run["physics"])]
    timing = run.get("time") or {}
    if unknown := set(timing) - {"real_time_factor", "paused"}:
        fail(f"time: unknown {sorted(unknown)[0]}; one of paused, real_time_factor")
    if "real_time_factor" in timing:
        args += ["--rtf", str(float(timing["real_time_factor"]))]
    if timing.get("paused"):
        args.append("--paused")
    for library in run.get("plugins") or []:
        args += ["--plugin", str(library)]
    if "ros_topics" in run:
        args += ["--ros-topics", file_of("ros_topics", run["ros_topics"])]
    if run.get("ros") is False:
        args.append("--no-ros")
    if "humans" in run:
        args += ["--humans", str(run["humans"])]
    for name, timing in (run.get("sensor_timing") or {}).items():
        if not isinstance(timing, dict) or set(timing) - {"latency", "jitter"}:
            fail("sensor_timing: each sensor is {latency: s, jitter: s}")
        delay = f"{float(timing.get('latency', 0))},{float(timing.get('jitter', 0))}"
        args += ["--sensor-timing", f"{name}={delay}"]
    for body in run.get("water") or []:
        missing = {"at", "size", "depth"} - set(body)
        if missing or len(body["at"]) != 3 or len(body["size"]) != 2:
            fail("water: each is {at: [x, y, surface height], size: [x, y], depth: m}")
        numbers = [*body["at"], *body["size"], body["depth"]]
        args += ["--water", ",".join(str(float(v)) for v in numbers)]
    if "record" in run:
        args += ["--record", str(base / str(run["record"]))]
    control = run.get("control", "joints")
    if control not in ("joints", "builtin"):
        fail("control: joints (each joint on its own, /joint_commands) or builtin")
    return [*args, *(["--joint-control"] if control == "joints" else []), "--no-demo"]


def set_site(argv: list[str]) -> int:
    try:
        import rclpy
        from rcl_interfaces.msg import Parameter, ParameterType
        from rcl_interfaces.srv import SetParameters
    except ImportError:
        sys.exit("lagrange: rclpy is missing (source the ROS 2 setup first)")
    if not argv:
        sys.exit("lagrange: set needs NAME=VALUE, such as gravity=1.62")
    parameters = []
    for item in argv:
        name, _, value = item.partition("=")
        try:
            number = float(value)
        except ValueError:
            sys.exit(f"lagrange: set: {item} is not NAME=VALUE")
        parameter = Parameter(name=name)
        parameter.value.type = ParameterType.PARAMETER_DOUBLE
        parameter.value.double_value = number
        parameters.append(parameter)
    rclpy.init()
    try:
        node = rclpy.create_node("lagrange_cli")
        client = node.create_client(SetParameters, "/lagrange_ros2_bridge/set_parameters")
        if not client.wait_for_service(timeout_sec=SERVICE_WAIT_SECONDS):
            sys.exit("lagrange: no simulator with ROS is running")
        future = client.call_async(SetParameters.Request(parameters=parameters))
        rclpy.spin_until_future_complete(node, future, timeout_sec=60.0)
        results = future.result().results if future.done() else []
        for parameter, result in zip(parameters, results, strict=False):
            if not result.successful:
                print(f"lagrange: {parameter.name}: {result.reason}", file=sys.stderr)
                return 1
        return 0 if results else 1
    finally:
        rclpy.try_shutdown()


def main(argv: list[str]) -> int:
    if argv and argv[0] == "set":
        return set_site(argv[1:])
    if argv and argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    if argv and argv[0] in TOOLS:
        os.execv(executable("lagrange_server", "lagrange"), ["lagrange", *argv])
    if argv and argv[0] == "check":
        tool = executable("lagrange_server", "lagrange_check")
        os.execv(tool, ["lagrange check", *argv[1:]])
    if argv and argv[0] == "bake":
        tool = executable("lagrange_collision_bake", "bake_urdf")
        os.execv(tool, ["lagrange bake", *argv[1:]])
    if argv and argv[0] == "tunnel":
        tool = executable("lagrange_server", "lagrange_tunnel")
        os.execv(tool, ["lagrange tunnel", *argv[1:]])
    if argv and argv[0] == "foam":
        tool = str(Path(__file__).resolve().parent / "lagrange_foam")
        os.execv(tool, ["lagrange foam", *argv[1:]])
    if argv and argv[0] == "foam-hover":
        tool = str(Path(__file__).resolve().parent / "lagrange_foam_hover")
        os.execv(tool, ["lagrange foam-hover", *argv[1:]])
    if argv and argv[0] == "foam-cht":
        tool = str(Path(__file__).resolve().parent / "lagrange_foam_cht")
        os.execv(tool, ["lagrange foam-cht", *argv[1:]])
    if argv and argv[0] == "viewer":
        viewer = executable("lagrange_viewer", "lagrange_viewer")
        os.execv(viewer, [viewer, *argv[1:]])
    if argv and argv[0] == "spawn":
        return spawn(argv[1:])
    if argv and argv[0] == "delete":
        return delete(argv[1:])
    if argv and argv[0] == "server":
        argv = ["--server-only", *argv[1:]]
    if argv and argv[0] == "samples":
        for name, (text, *_rest) in samples().items():
            print(f"  {name:8} {text}")
        return 0

    server_args, viewer_args = argv, []
    if "--" in argv:
        cut = argv.index("--")
        server_args, viewer_args = argv[:cut], argv[cut + 1 :]
    server_only = False
    for flag in ("--server-only", "-s"):
        while flag in server_args:
            server_args.remove(flag)
            server_only = True

    # A season: how the viewer draws the year, and the weather it brings to the run.
    if "--season" in server_args:
        at = server_args.index("--season")
        name = server_args[at + 1] if at + 1 < len(server_args) else ""
        if name not in SEASONS:
            sys.exit(f"lagrange: --season takes {', '.join(SEASONS)}, not '{name}'")
        del server_args[at : at + 2]
        server_args += ["--weather", SEASONS[name], "--camera-season", name]
        viewer_args = ["--season", name, *viewer_args]

    # A sample by name, or a robot file and a world file as the first words.
    words = []
    while server_args and not server_args[0].startswith("-"):
        words.append(server_args.pop(0))
    chosen = samples()
    if words and words[0] in chosen:
        _text, sample_server, sample_viewer, fetched = chosen[words.pop(0)]
        if fetched and not asset_fetched(fetched):
            print(
                f"lagrange: the meshes of this sample are not fetched; it runs with boxes "
                f"in their place (ros2 run lagrange_assets fetch_assets {fetched})",
                file=sys.stderr,
            )
        server_args = [*sample_server, *server_args]
        viewer_args = [*sample_viewer, *viewer_args]
    if len(words) > 2:
        sys.exit(f"lagrange: unexpected '{words[2]}' (lagrange --help)")
    # A simulation profile (it has domains:, which a run file cannot): `lagrange run PROFILE`
    # as the server, with the viewer, as for a sample.
    profile = None
    if words and words[0].endswith((".yaml", ".yml")) and is_profile(words[0]):
        if len(words) > 1:
            sys.exit(f"lagrange: unexpected '{words[1]}' after a profile; use --robot, --world")
        profile = str(Path(words.pop(0)).resolve())
    if words and words[0].endswith((".yaml", ".yml")) and Path(words[0]).is_file():
        if len(words) > 1:
            sys.exit(f"lagrange: unexpected '{words[1]}' after a run file")
        run_file = words.pop(0)
        try:
            server_args = [*run_file_args(run_file), *server_args]
        except (TypeError, ValueError, KeyError, AttributeError) as bad:
            sys.exit(f"lagrange: {run_file}: a key has a value of the wrong kind: {bad}")
    elif words:
        # Your own robot: on an empty ground unless a world is named, and still until you
        # command it. The samples' warehouse and demo drive are for the samples.
        if len(words) == 1 and "--world" not in server_args:
            server_args = ["--world", "none", *server_args]
        if "--no-demo" not in server_args:
            server_args = ["--no-demo", "--joint-control", *server_args]
    for flag, word in zip(("--robot", "--world"), words, strict=False):
        if word not in chosen and not Path(word).exists():
            sys.exit(f"lagrange: no sample or file '{word}' (lagrange samples)")
        server_args = [flag, word, *server_args]

    server = [executable("lagrange_server", "lagrange_server")]
    if profile:
        server = [executable("lagrange_server", "lagrange"), "run", profile]
    if server_only:
        os.execv(server[0], [*server, *server_args])

    # The server listens on an endpoint of this run unless told otherwise, so that it never
    # meets another simulator on the default socket.
    if "--listen" in server_args:
        endpoint = server_args[server_args.index("--listen") + 1]
    else:
        endpoint = own_endpoint()
        server_args = [*server_args, "--listen", endpoint]
    if "--connect" not in viewer_args:
        viewer_args = ["--connect", endpoint, *viewer_args]

    server_process = subprocess.Popen([*server, *server_args])
    deadline = time.monotonic() + SERVER_START_SECONDS
    while not reachable(endpoint):
        if server_process.poll() is not None:
            return server_process.returncode or 1
        if time.monotonic() > deadline:
            print("lagrange: the server did not start listening", file=sys.stderr)
            return stop(server_process) or 1
        time.sleep(0.1)

    # Ctrl-C reaches both processes (same terminal); wait for them instead of dying first.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    viewer_process = subprocess.Popen(
        [executable("lagrange_viewer", "lagrange_viewer"), *viewer_args],
        preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL),
    )
    while viewer_process.poll() is None and server_process.poll() is None:
        time.sleep(0.2)
    server_ended_first = server_process.poll() is not None
    viewer_status = stop(viewer_process)
    server_status = stop(server_process)
    if endpoint.startswith("unix:"):
        Path(endpoint[5:]).unlink(missing_ok=True)
    if server_ended_first:
        print(f"lagrange: the server stopped (exit {server_status})", file=sys.stderr)
        return server_status or 1
    return viewer_status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
