"""lagrange: the simulator and its viewer from one command, like `gazebo`.

lagrange [SAMPLE | ROBOT [WORLD]] [SERVER OPTIONS] [-- VIEWER OPTIONS]
    the server and the viewer together; closing the viewer stops the server
lagrange --server-only ...      the server alone, headless (like gzserver)
lagrange viewer [VIEWER OPTIONS]  the viewer alone (like gzclient)
lagrange samples                the sample names
lagrange run|validate|graph|determinism|export|info ...
    the lagrange_server tools (as `ros2 run lagrange_server lagrange ...`)
"""

import os
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

TOOLS = {"run", "validate", "graph", "determinism", "export", "info"}
SERVER_START_SECONDS = 300.0  # large worlds and vehicles take a while to load
STOP_SECONDS = 10.0


def executable(package: str, name: str) -> str:
    from ament_index_python.packages import PackageNotFoundError, get_package_prefix

    try:
        path = Path(get_package_prefix(package)) / "lib" / package / name
    except PackageNotFoundError:
        sys.exit(f"lagrange: {package} is not installed (source the ROS setup that has it)")
    if not os.access(path, os.X_OK):
        sys.exit(f"lagrange: {path} is missing")
    return str(path)


def asset(relative: str) -> str:
    from ament_index_python.packages import get_package_share_directory

    return str(Path(get_package_share_directory("lagrange_assets")) / relative)


# name: (description, server arguments, viewer arguments, fetched asset or None)
