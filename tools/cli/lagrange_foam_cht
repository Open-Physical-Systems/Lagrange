#!/usr/bin/env python3
# ruff: noqa: E501  (OpenFOAM dictionaries are written as they read, one entry a line)
"""lagrange foam-cht ROBOT: the robot's links with a thermal material through OpenFOAM's conjugate
heat transfer (chtMultiRegionSimpleFoam), in a process of its own (RFC 0012).

Each link with a ThermalMaterialAPI_1 (URDF <thermal_material>) becomes a solid region of its
collision shapes, with its conductivity, density and specific heat; still air around them is the
fluid region, with buoyancy; each heat source heats the cells of its box (fvOptions); a link's
contact conductance to its parent is a thin layer on their interface. The case runs with an
installed OpenFOAM or the official container, and each region's and source's temperature is read
back into report.json, beside the conduction fidelity's when --compare names its run. OpenFOAM is
GPL-3 and stays a separate program: Lagrange exchanges only files with it.
"""

from __future__ import annotations

import argparse
import json
import math
import re
import shutil
import subprocess
import sys
from pathlib import Path

IMAGE = "docker.io/opencfd/openfoam-default:2512"
AIR_MOLAR_MASS = 28.9  # g/mol
AIR_CP = 1007.0  # J/(kg·K), 300 K (Incropera Table A.4)
AIR_MU = 1.846e-5  # Pa·s, 300 K (Incropera Table A.4)
AIR_PR = 0.707  # Incropera Table A.4
GRAVITY = 9.80665  # m/s², standard
PRESSURE = 101325.0  # Pa
MARGIN_SIDE, MARGIN_BELOW, MARGIN_ABOVE = 1.5, 1.0, 3.0  # air around the solids, in their size
CONTACT_LAYER = 1e-4  # m: the thin layer that stands for a contact conductance (κ = h·t)

HEADER = """FoamFile
{{
    version 2.0;
    format ascii;
    class {cls};
    object {name};
}}
"""


def foam_file(path: Path, name: str, body: str, cls: str = "dictionary") -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(HEADER.format(cls=cls, name=name) + body)


def vector(v: list[float]) -> str:
    return "(" + " ".join(f"{x:.9g}" for x in v) + ")"


def plan(surface: dict, thermal: dict, args: argparse.Namespace) -> dict:
    """The air box, the base cell and each solid's refinement level."""
    low, high = surface["low"], surface["high"]
    size = [h - lo for lo, h in zip(low, high, strict=True)]
    largest = max(size)
    box_low = [low[0] - MARGIN_SIDE * largest, low[1] - MARGIN_SIDE * largest,
               low[2] - MARGIN_BELOW * largest]  # fmt: skip
    box_high = [high[0] + MARGIN_SIDE * largest, high[1] + MARGIN_SIDE * largest,
                high[2] + MARGIN_ABOVE * largest]  # fmt: skip
    base = largest / args.base_cells
    cells = [max(1, math.ceil((h - lo) / base)) for lo, h in zip(box_low, box_high, strict=True)]
    levels = {}
    for part in thermal["parts"]:
        # Two cells through the thinnest shape (the conduction fidelity's cell is half of it),
        # and args.refine more for the gradients near a heat source.
        target = part["cell"] / args.cells_through
        levels[part["name"]] = max(1, min(args.max_level, math.ceil(math.log2(base / target))))
    return {"low": box_low, "high": box_high, "cells": cells, "base": base, "levels": levels}


def write_mesh(case: Path, p: dict, parts: list[dict]) -> None:
    foam_file(case / "system" / "blockMeshDict", "blockMeshDict", f"""
convertToMeters 1;
vertices
(
    {vector([p['low'][0], p['low'][1], p['low'][2]])}
    {vector([p['high'][0], p['low'][1], p['low'][2]])}
    {vector([p['high'][0], p['high'][1], p['low'][2]])}
    {vector([p['low'][0], p['high'][1], p['low'][2]])}
    {vector([p['low'][0], p['low'][1], p['high'][2]])}
    {vector([p['high'][0], p['low'][1], p['high'][2]])}
    {vector([p['high'][0], p['high'][1], p['high'][2]])}
    {vector([p['low'][0], p['high'][1], p['high'][2]])}
);
blocks ( hex (0 1 2 3 4 5 6 7) ({p['cells'][0]} {p['cells'][1]} {p['cells'][2]}) simpleGrading (1 1 1) );
boundary
(
    walls {{ type wall; faces ( (0 4 7 3) (1 2 6 5) (0 1 5 4) (3 7 6 2) (0 3 2 1) ); }}
    top {{ type patch; faces ( (4 5 6 7) ); }}
);
""")  # fmt: skip
    geometry = "\n".join(
        f"    {q['name']}.stl {{ type triSurfaceMesh; name {q['name']}; }}" for q in parts
    )
    surfaces = "\n".join(
        f"        {q['name']} {{ level ({p['levels'][q['name']]} {p['levels'][q['name']]}); }}"
        for q in parts
    )
    # The air: a point in the box away from every solid (the box's top corner region).
    air = [p["low"][0] + 0.5 * p["base"], p["low"][1] + 0.5 * p["base"],
           p["high"][2] - 0.5 * p["base"]]  # fmt: skip
    locations = "\n".join(f"        ({vector(q['inside'])} {q['name']})" for q in parts)
    foam_file(case / "system" / "snappyHexMeshDict", "snappyHexMeshDict", f"""
castellatedMesh true;
snap true;
addLayers false;
geometry
{{
{geometry}
}}
castellatedMeshControls
{{
    maxLocalCells 5000000;
    maxGlobalCells 20000000;
    minRefinementCells 0;
    nCellsBetweenLevels 3;
    features ();
    refinementSurfaces
    {{
{surfaces}
    }}
    resolveFeatureAngle 30;
    refinementRegions {{}}
    locationsInMesh
    (
        ({vector(air)} air)
{locations}
    );
    allowFreeStandingZoneFaces false;
}}
snapControls
{{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 50;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap true;
}}
addLayersControls
{{
    relativeSizes true;
    layers {{}}
    expansionRatio 1.2;
    finalLayerThickness 0.5;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}}
meshQualityControls
{{
    #includeEtc "caseDicts/meshQualityDict"
    nSmoothScale 4;
    errorReduction 0.75;
}}
