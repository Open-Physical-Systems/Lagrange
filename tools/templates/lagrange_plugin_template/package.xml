<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- Copy this directory, then rename the package, the library and the module. -->
  <name>my_lagrange_plugin</name>
  <version>0.1.0</version>
  <description>A Lagrange plugin (RFC 0008): one module against the C ABI, loaded with lagrange_server --plugin my_lagrange_plugin.</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>lagrange_core</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>lagrange_server</test_depend>
  <test_depend>lagrange_assets</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
