<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lagrange_viewer</name>
  <version>0.3.0</version>
  <description>Lagrange viewer: a native Vulkan and Dear ImGui desktop application. It talks to a simulation only through the viewer protocol and links no simulation module.</description>
  <maintainer email="danendraclever24@gmail.com">Danendra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>lagrange_cmake</buildtool_depend>

  <depend>lagrange_proto</depend>
  <depend>lagrange_gpu</depend>
  <depend>imgui_vendor</depend>
  <depend>libsdl3-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>lagrange_mock_server</test_depend>
  <test_depend>lagrange_server</test_depend>
  <test_depend>mesa-vulkan-drivers</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
