<?xml version="1.0"?>
<!-- A robot with blocks the builder keeps as written. -->
<robot name="kept_blocks">
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- the base -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.025"/>
    </inertial>
  </link>
  <link name="wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="1e-04" ixy="0" ixz="0" iyy="2e-04" iyz="0" izz="1e-04"/>
    </inertial>
  </link>
  <joint name="wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel"/>
    <origin xyz="0 0.12 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2" velocity="20"/>
    <safety_controller k_velocity="10"/>
  </joint>
  <transmission name="wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
  </transmission>
  <gazebo reference="wheel">
    <mu1>0.9</mu1>
    <sensor_material preset="black_rubber"/>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.5</mu1>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="front_range" type="rangefinder">
      <pose>0.15 0 0 0 0 0</pose>
      <update_rate>20</update_rate>
      <rangefinder>
        <range>
          <max>8</max>
        </range>
      </rangefinder>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="rear_range" type="rangefinder">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>20</update_rate>
      <rangefinder>
        <range>
          <max>4</max>
          <min>0.05</min>
        </range>
      </rangefinder>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>100</update_rate>
      <latency>0.002</latency>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0.08 0 0 0</pose>
      <update_rate>10</update_rate>
      <lidar>
        <range>
          <max>12</max>
        </range>
        <scan>
          <horizontal>
            <samples>360</samples>
          </horizontal>
        </scan>
      </lidar>
      <topic>scan</topic>
    </sensor>
  </gazebo>
  <ros2_control name="LagrangeSystem" type="system">
    <hardware>
      <plugin>lagrange_ros2_control/LagrangeSystem</plugin>
    </hardware>
    <joint name="wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
