<?xml version="1.0"?>
<!-- rover_mk1: the sample document of docs/design/ui/12-builder/README.md (RFC 0016), written
     by hand. It is the input of the builder's tests and of its screenshot; the numbers on the
     Builder screen come from here, never from panel code.

     Parts as the README lists them (shapes, densities, joints, sensors). The README gives no
     positions; these are chosen here (base_link's origin at the box's centre, 0.13 m above
     the ground, as the README says). Every <inertial> is the closed form of RFC 0016 §4 for its
     shape and the README's density (wheels and caster 1100 kg/m³, mast 2700, pan and tilt
     1240; base_link's 8.00 kg is the README's override). With these positions: total
     10.983 kg, COM (0.0075, 0.000, 0.0032) m in base_link's frame. The README states 10.99 kg
     and (0.007, 0.000, 0.003) m; its listed parts sum to 10.983 kg.

     Joint limits are picked for the picture (README). The pan and tilt joints' effort and
     velocity are illustrative only: the README gives none, and URDF requires them. -->
<robot name="rover_mk1">

  <material name="body">
    <color rgba="0.66 0.72 0.81 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.5 0.36 0.12"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <geometry><box size="0.5 0.36 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="8"/>
      <inertia ixx="0.096" ixy="0" ixz="0" iyy="0.17626666666666668" iyz="0" izz="0.25306666666666666"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="tyre"><color rgba="0.16 0.18 0.22 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8846724912508859"/>
      <inertia ixx="0.0015334323181682022" ixy="0" ixz="0" iyy="0.002830951972002835" iyz="0" izz="0.0015334323181682022"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.1 0.2 -0.05"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
      <material name="tyre"/>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8846724912508859"/>
      <inertia ixx="0.0015334323181682022" ixy="0" ixz="0" iyy="0.002830951972002835" iyz="0" izz="0.0015334323181682022"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.1 -0.2 -0.05"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
      <material name="tyre"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1975538180332382"/>
      <inertia ixx="9.680137083628675e-05" ixy="0" ixz="0" iyy="9.680137083628675e-05" iyz="0" izz="9.680137083628675e-05"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.22 0 -0.095"/>
  </joint>

  <link name="mast">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.02" length="0.2"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry><cylinder radius="0.02" length="0.2"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1"/>
      <mass value="0.6785840131753954"/>
      <inertia ixx="0.0023298051119021914" ixy="0" ixz="0" iyy="0.0023298051119021914" iyz="0" izz="0.0001357168026350791"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="-0.15 0 0.06"/>
  </joint>

  <link name="pan_link">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.17856"/>
      <inertia ixx="7.7376e-05" ixy="0" ixz="0" iyy="7.7376e-05" iyz="0" izz="0.00010713599999999999"/>
    </inertial>
  </link>
  <joint name="pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pan_link"/>
    <origin xyz="0.15 0 0.06"/>
    <axis xyz="0 0 1"/>
    <!-- -170 ... 170 degrees; effort (N·m) and velocity (rad/s) illustrative -->
    <limit lower="-2.9670597283903604" upper="2.9670597283903604" effort="2" velocity="3"/>
  </joint>

  <link name="tilt_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15872000000000003"/>
      <inertia ixx="0.00010581333333333335" ixy="0" ixz="0" iyy="4.232533333333334e-05" iyz="0" izz="0.00010581333333333335"/>
    </inertial>
  </link>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 1 0"/>
    <!-- -45 ... 60 degrees; effort (N·m) and velocity (rad/s) illustrative -->
    <limit lower="-0.7853981633974483" upper="1.0471975511965976" effort="2" velocity="3"/>
  </joint>

  <!-- Sensors: lidar on the mast, camera on the tilt head, a rangefinder (a built-in kind) and
       the IMU on base_link. range/max 20 m and 100 Hz differ from the catalog's defaults (12 m,
       10 Hz), as in the reference picture. -->
  <gazebo reference="mast">
    <sensor name="lidar" type="lidar">
      <pose>0 0 0.22 0 0 0</pose>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159265358979</min_angle>
            <max_angle>3.14159265358979</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="tilt_link">
    <sensor name="camera" type="camera">
      <pose>0.02 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.02</near><far>20</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="front_range" type="rangefinder">
      <pose>0.25 0 -0.03 0 0 0</pose>
      <update_rate>100</update_rate>
      <rangefinder><range><max>20</max></range></rangefinder>
    </sensor>
    <sensor name="imu" type="imu">
      <update_rate>200</update_rate>
    </sensor>
  </gazebo>

</robot>
